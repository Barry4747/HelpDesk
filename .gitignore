# HelpDesk — .gitignore

# ── Python / Backend ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.env
*.env

# ── Alembic ───────────────────────────────────────────────────────────────
# (wersjonujemy alembic/versions/*.py, pomijamy tylko artefakty)

# ── Node / Frontend ───────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env

# ── Docker ────────────────────────────────────────────────────────────────
# (docker-compose.dev.yml trafia do repo, pomijamy override z sekretami)
docker-compose.override.yml

# ── IDE / OS ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logi i dane tymczasowe ────────────────────────────────────────────────
*.log
*.sqlite3
