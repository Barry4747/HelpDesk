# UWAGA: Ten plik to tylko szablon dla środowiska Docker Compose.
# Skopiuj ten plik i zapisz jako `.env.docker` w tym samym folderze (czyli `backend/`), 
# a następnie wypełnij właściwymi wartościami dla Twojego lokalnego środowiska.
# Plik `.env.docker` jest ignorowany przez Gita i nie trafi do repozytorium.

POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=helpdesk
DATABASE_URL=postgresql://helpdesk:changeme@postgres:5432/helpdesk
JWT_SECRET=devsecret
